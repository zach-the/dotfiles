#!/usr/bin/env python3
import sys
import os
import subprocess
import selectors
import signal
import re
import fcntl
import time
import base64

_ANSI_ESC = re.compile(r'\033\[[^a-zA-Z]*[a-zA-Z]')
_SGR = re.compile(r'\033\[([0-9;]*)m')
_SGR_MOUSE = re.compile(rb'\033\[<(\d+);(\d+);(\d+)([Mm])')
MAX_BUFFER = 10_000  # lines per file
WHEEL_SCROLL_LINES = 3  # lines scrolled per mouse wheel notch

# --- -m (merged) mode ---
MERGE_TAG_MAXLEN = 24     # cap on a tag's displayed length before middle-truncation
MERGE_PRIME_MAX_S = 1.0   # hard cap on how long we wait for initial backlog to settle
MERGE_PRIME_QUIET_S = 0.15  # ...but bail out early once nothing new arrives for this long

_RED_RE = re.compile(r'\b(errors?|stop)\b', re.IGNORECASE)
_WARN_RE = re.compile(r'\b(warn\w*)\b', re.IGNORECASE)
_RED = '\033[1;31m'
_YELLOW = '\033[1;33m'
_COLOR_RESET = '\033[0m'

# -c: per-file tag colors (sidebar tag only -- never the top header bar).
# Cycles if there are more files than colors.
_TAG_PALETTE = ['\033[1;32m', '\033[1;34m', '\033[1;35m']  # green, blue, purple

# Divider between a merged line's tag and its text -- one space of padding
# on each side of the bar.
MERGE_DIVIDER = ' │ '

def colorize_keywords(text):
    """Wrap 'error'/'errors'/'stop' in red and 'warn'/'warning'/etc. in
    yellow, case-insensitively. Applied to every tailed line (both plain and
    -m merged mode) so these stand out without having to grep for them."""
    text = _RED_RE.sub(lambda m: f'{_RED}{m.group(0)}{_COLOR_RESET}', text)
    text = _WARN_RE.sub(lambda m: f'{_YELLOW}{m.group(0)}{_COLOR_RESET}', text)
    return text

def truncate_middle(s, maxlen):
    """Shorten s to at most maxlen chars by cutting out its middle and
    splicing in a single ellipsis -- keeps both a recognizable prefix and
    suffix (e.g. distinguishing extensions/suffixes on similarly-named
    files), unlike truncating off one end."""
    if maxlen < 3 or len(s) <= maxlen:
        return s
    keep = maxlen - 1  # minus the ellipsis character itself
    left = (keep + 1) // 2
    right = keep - left
    return s[:left] + '…' + (s[-right:] if right > 0 else '')

def distinguishing_tags(names):
    """When every name shares a common prefix and/or suffix (e.g. the same
    base tag, differing only by '.err' vs '.out'), strip that shared part
    off and use just the differing middle as each one's tag instead of the
    full name -- 'TAG.1.err'/'TAG.1.out' become 'err'/'out'. Falls back to
    the full names whenever stripping would be degenerate (fewer than 2
    names, an empty result, or a collision between two results)."""
    if len(names) < 2:
        return list(names)
    prefix_len = len(os.path.commonprefix(names))
    suffix_len = len(os.path.commonprefix([n[::-1] for n in names]))
    # Don't let the prefix and suffix overlap within the shortest name.
    shortest = min(len(n) for n in names)
    if prefix_len + suffix_len > shortest:
        suffix_len = max(0, shortest - prefix_len)
    trimmed = [n[prefix_len: len(n) - suffix_len] for n in names]
    if all(trimmed) and len(set(trimmed)) == len(trimmed):
        return trimmed
    return list(names)

def _visible_len(s):
    return len(_ANSI_ESC.sub('', s))

def _ljust_visible(s, width):
    pad = width - _visible_len(s)
    return s + ' ' * pad if pad > 0 else s

def _wrap_ansi(line, width):
    """Wrap line at `width` visible characters, carrying active SGR color state to each new chunk."""
    chunks, active, chunk, visible = [], [], "", 0
    i = 0
    while i < len(line):
        m = _ANSI_ESC.match(line, i)
        if m:
            seq = m.group()
            chunk += seq
            i = m.end()
            sgr = _SGR.fullmatch(seq)
            if sgr:
                if sgr.group(1) in ('', '0'):
                    active = []
                else:
                    active.append(seq)
        else:
            chunk += line[i]
            visible += 1
            i += 1
            if visible >= width:
                chunks.append(chunk)
                chunk = ''.join(active)
                visible = 0
    if chunk:
        chunks.append(chunk)
    return chunks if chunks else [""]

def _highlight(s, start, end):
    """Reverse-video the visible characters [start, end) of s. Reverse is
    re-asserted after every escape sequence inside the range, so an SGR
    reset in the middle of the text doesn't cut the highlight short."""
    if end <= start:
        return s
    out, vis, i, on = [], 0, 0, False
    while i < len(s):
        m = _ANSI_ESC.match(s, i)
        if m:
            out.append(m.group())
            if on:
                out.append('\033[7m')
            i = m.end()
            continue
        if vis == start:
            out.append('\033[7m')
            on = True
        elif vis == end and on:
            out.append('\033[27m')
            on = False
        out.append(s[i])
        vis += 1
        i += 1
    if on:
        out.append('\033[27m')
    return ''.join(out)

def selection_text(buf, start, end):
    """Plain text of a selection over buf's raw lines. start/end are
    (line index, visible offset), both inclusive. Works on the raw lines
    rather than what's on screen, so a line that got wrapped for display
    comes back as one line, with no newline planted at the wrap point."""
    (l0, o0), (l1, o1) = start, end
    out = []
    for li in range(max(0, l0), min(l1, len(buf) - 1) + 1):
        s = _ANSI_ESC.sub('', buf[li].replace('\t', '    '))
        out.append(s[o0 if li == l0 else 0: o1 + 1 if li == l1 else len(s)])
    return '\n'.join(out)

def osc52_copy(text):
    """Put text on the system clipboard via an OSC 52 escape -- the terminal
    does the copy, so it works over ssh with no clipboard tool on this end."""
    data = base64.b64encode(text.encode('utf-8', 'replace')).decode('ascii')
    sys.stdout.write(f'\033]52;c;{data}\a')
    sys.stdout.flush()

def get_terminal_size():
    try:
        import struct, termios as _t
        h, w, _, _ = struct.unpack('HHHH',
            fcntl.ioctl(sys.stdout.fileno(), _t.TIOCGWINSZ,
            struct.pack('HHHH', 0, 0, 0, 0)))
        if w > 0 and h > 0:
            return w, h
    except Exception:
        pass
    try:
        import shutil
        s = shutil.get_terminal_size((80, 24))
        if s.columns > 0 and s.lines > 0:
            return s.columns, s.lines
    except Exception:
        pass
    return 80, 24

def parse_mouse(raw):
    """Parse SGR mouse events. Returns a list of (btn, col, row, pressed),
    col/row 0-indexed -- a list because a fast drag can deliver several
    events in one read, and dropping all but the first could lose the
    button release that ends it."""
    if not raw.startswith(b'\033[<'):
        return []
    return [(int(b), int(c) - 1, int(r) - 1, k == b'M')
            for b, c, r, k in _SGR_MOUSE.findall(raw)]

def compute_col_widths(total_width, n_files):
    """Equal column content widths (excluding │ dividers) that together fill total_width."""
    content = max(n_files, total_width - (n_files - 1))
    base = content // n_files
    rem = content % n_files
    return [base + (1 if i < rem else 0) for i in range(n_files)]

def get_divider_cols(col_widths):
    """0-indexed absolute column positions of each │ divider."""
    cols, pos = [], 0
    for w in col_widths[:-1]:
        pos += w
        cols.append(pos)
        pos += 1
    return cols

def fracs_to_col_widths(fracs, total_width, n_files):
    """Reconstruct col_widths from saved divider fractions after a terminal resize."""
    if not fracs:
        return compute_col_widths(total_width, n_files)
    MIN_W = 5
    div_cols = [round(f * total_width) for f in fracs]
    limit = MIN_W
    for i in range(len(div_cols)):
        if div_cols[i] < limit:
            div_cols[i] = limit
        limit = div_cols[i] + MIN_W + 1
    limit = total_width - 1 - MIN_W
    for i in range(len(div_cols) - 1, -1, -1):
        if div_cols[i] > limit:
            div_cols[i] = limit
        limit = div_cols[i] - MIN_W - 1
    return dividers_to_widths(div_cols, total_width, n_files)

def dividers_to_widths(d_cols, total_width, n_files):
    """Derive col_widths from absolute divider column positions."""
    widths, prev = [], 0
    for d in d_cols:
        widths.append(max(1, d - prev))
        prev = d + 1
    widths.append(max(1, total_width - prev))
    return widths

def drag_divider(d_idx, new_col, div_cols, width):
    """
    Move divider d_idx to new_col, cascading into neighbors when the gap
    would fall below MIN_W, so dragging one border into another pushes both.
    """
    MIN_W = 5
    n = len(div_cols)
    result = list(div_cols)
    result[d_idx] = new_col

    # Push dividers to the right of d_idx rightward if needed
    for i in range(d_idx + 1, n):
        min_pos = result[i - 1] + MIN_W + 1
        if result[i] < min_pos:
            result[i] = min_pos

    # Push dividers to the left of d_idx leftward if needed
    for i in range(d_idx - 1, -1, -1):
        max_pos = result[i + 1] - MIN_W - 1
        if result[i] > max_pos:
            result[i] = max_pos

    # Hard clamp from right boundary, cascading leftward
    limit = width - 1 - MIN_W
    for i in range(n - 1, -1, -1):
        if result[i] > limit:
            result[i] = limit
        limit = result[i] - MIN_W - 1

    # Hard clamp from left boundary, cascading rightward
    limit = MIN_W
    for i in range(n):
        if result[i] < limit:
            result[i] = limit
        limit = result[i] + MIN_W + 1

    return result

def read_key(fd):
    """Read a key or escape sequence from fd; returns bytes."""
    c = os.read(fd, 1)
    if c == b'\x1b':
        flags = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
        try:
            c += os.read(fd, 1024)
        except (BlockingIOError, OSError):
            pass
        finally:
            fcntl.fcntl(fd, fcntl.F_SETFL, flags)
    return c

def draw_screen(files, buffers, width, height, follow_mode, view_tops, col_widths, blank_fill=None, merged=False, selection=None):
    """
    Render the TUI. Returns (view_tops, at_bottom, last_frame, row_map).
    col_widths: list of content widths per column (not counting │ dividers).
    blank_fill: per-column text to show on rows past a column's last buffered
    line (default: blank). Used by -m merged mode to keep its tag-column
    divider bar continuous down rows with no content yet.
    merged: -m mode. Each tailed line stays a single row instead of being
    pre-split at col width -- the terminal does its own soft-wrap for
    anything too long. Pre-splitting looks identical on screen but plants a
    real row break (and terminating newline) at the wrap point, so copying
    a wrapped line picks up an invisible hard newline the terminal never
    actually put there.
    selection: (column, start, end) to draw highlighted, start/end being
    inclusive (raw line index, visible offset) positions in that column's
    buffer. row_map is the inverse the caller needs to build one from mouse
    coordinates: per column, per content row, the (raw line index, visible
    offset) that row starts at, or None for a row past the last line.
    """
    n = len(files)
    if blank_fill is None:
        blank_fill = [""] * n
    if width < n * 5:
        sys.stdout.write(f'\033[H Terminal too small: {width}x{height}\033[K')
        sys.stdout.flush()
        return view_tops, False, [], []

    content_lines = height - 1  # one row for the header

    # Wrap all raw buffers into display lines
    # origins parallels wrapped: the (raw line index, visible offset) each
    # display line starts at.
    wrapped, origins = [], []
    for i, buf in enumerate(buffers):
        cw = col_widths[i]
        max_len = max(1, cw - 1 if i < n - 1 else cw)
        w, o = [], []
        for ri, raw in enumerate(buf):
            raw = raw.replace('\t', '    ')
            if merged:
                w.append(raw)
                o.append((ri, 0))
            else:
                for k, chunk in enumerate(_wrap_ansi(raw, max_len) if raw else [""]):
                    w.append(chunk)
                    o.append((ri, k * max_len))
        wrapped.append(w)
        origins.append(o)

    def hl(line, i, idx):
        if selection is None or selection[0] != i:
            return line
        ri, off = origins[i][idx]
        (l0, o0), (l1, o1) = selection[1], selection[2]
        if not l0 <= ri <= l1:
            return line
        start = o0 - off if ri == l0 else 0
        end = o1 + 1 - off if ri == l1 else float('inf')
        return _highlight(line, max(0, start), end)

    # Compute effective view start positions
    new_tops = []
    merged_end = 0  # merged mode: index one past the last fully-visible line
    merged_rows = 0  # merged mode: screen rows those visible lines occupy
    if merged:
        # Lines aren't pre-split, so one can span several screen rows when
        # the terminal soft-wraps it. Budget by those physical rows, not by
        # line count, or the frame overflows the screen and scrolls the
        # header off the top. Whole lines only; the first is always kept.
        w = wrapped[0]
        hs = [max(1, -(-_visible_len(l) // width)) for l in w]
        rows, bottom_top = 0, len(w)
        while bottom_top > 0 and (rows == 0 or rows + hs[bottom_top - 1] <= content_lines):
            rows += hs[bottom_top - 1]
            bottom_top -= 1
        if follow_mode:
            top = bottom_top
        else:
            prev = view_tops[0] if view_tops else 0
            top = max(0, min(prev, bottom_top))
        merged_end = top
        while merged_end < len(w) and (merged_rows == 0 or merged_rows + hs[merged_end] <= content_lines):
            merged_rows += hs[merged_end]
            merged_end += 1
        new_tops.append(top)
    else:
        for i, w in enumerate(wrapped):
            total = len(w)
            if follow_mode:
                new_tops.append(max(0, total - content_lines))
            else:
                prev = view_tops[i] if i < len(view_tops) else 0
                new_tops.append(max(0, min(prev, max(0, total - content_lines))))

    sys.stdout.write('\033[H')
    out = []

    # Header row: each column gets its own filename + scroll indicator.
    # behinds is tracked regardless of follow_mode (not just in the branch
    # that displays it) since the caller also needs it to know whether a
    # manual scroll has reached the very bottom.
    header = ""
    behinds = []
    for i, f in enumerate(files):
        is_last = i == n - 1
        cw = col_widths[i]
        name = f" {os.path.basename(f)} "

        wi = wrapped[i]
        if merged:
            behind = len(wi) - merged_end
        else:
            behind = max(0, len(wi) - (new_tops[i] + content_lines))
        behinds.append(behind)

        if follow_mode:
            ind = " LIVE "
        else:
            ind = f" -{behind}L " if behind > 0 else " END "

        avail = cw - _visible_len(ind) - 1
        if _visible_len(name) > avail:
            name = " " + f[:max(1, avail - 3)] + "… "
        pad = cw - _visible_len(name) - _visible_len(ind)
        cell = name + " " * max(0, pad) + ind

        header += f'\033[7m{_ljust_visible(cell, cw)}\033[0m'
        if not is_last:
            header += '│'
    out.append(header + '\033[K')

    # Content rows
    row_map = [[] for _ in range(n)]
    if merged:
        for idx in range(new_tops[0], merged_end):
            out.append(hl(wrapped[0][idx], 0, idx) + '\033[0m\033[K')
            row_map[0].extend((idx, r * width) for r in range(hs[idx]))
        out.extend(['\033[K'] * (content_lines - merged_rows))
        row_map[0] = (row_map[0] + [None] * content_lines)[:content_lines]
    for y in range(content_lines if merged else 0, content_lines):
        row = ""
        for i in range(n):
            w = wrapped[i]
            cw = col_widths[i]
            idx = new_tops[i] + y
            if idx < len(w):
                line = hl(w[idx], i, idx)
                row_map[i].append(origins[i][idx])
            else:
                line = blank_fill[i]
                row_map[i].append(None)
            is_last = i == n - 1
            if not is_last:
                row += _ljust_visible(line, cw) + '\033[0m│'
            else:
                # No pad needed here -- the trailing \033[K below already
                # clears any stale content out to the end of the line, so
                # padding would just be literal trailing spaces that show up
                # on copy-paste.
                row += line + '\033[0m'
        out.append(row + '\033[K')

    for i, line in enumerate(out):
        sys.stdout.write(line)
        if i < len(out) - 1:
            sys.stdout.write('\n')
    sys.stdout.flush()
    # at_bottom: true once every column has caught up to its own end -- lets
    # the caller auto-resume follow mode when a manual scroll reaches the
    # bottom, instead of leaving it stuck showing "END" forever.
    at_bottom = all(b == 0 for b in behinds)
    # last_frame: this frame's header + content rows with trailing blank
    # rows trimmed off (there's no old content left to overwrite once this
    # gets replayed onto the primary screen on exit, so padding out to the
    # full pane height would just dump empty lines into the shell scrollback).
    last_frame = list(out)
    while len(last_frame) > 1 and _ANSI_ESC.sub('', last_frame[-1]).replace('│', '').strip() == '':
        last_frame.pop()
    return new_tops, at_bottom, last_frame, row_map


def main():
    width, height = get_terminal_size()
    args = sys.argv[1:]
    n_lines = height
    n_lines_given = False
    files = []
    merged = False
    tag_colors = False

    i = 0
    while i < len(args):
        if args[i] == '-n' and i + 1 < len(args):
            try:
                n_lines = int(args[i + 1]); n_lines_given = True
            except ValueError:
                pass
            i += 2
        elif args[i].startswith('-n') and args[i][2:].isdigit():
            n_lines = int(args[i][2:]); n_lines_given = True; i += 1
        elif args[i] == '-m':
            merged = True; i += 1
        elif args[i] == '-c':
            tag_colors = True; i += 1
        elif args[i].startswith('-') and args[i][1:].isdigit():
            n_lines = int(args[i][1:]); n_lines_given = True; i += 1
        else:
            files.append(args[i]); i += 1

    if not files:
        sys.exit(0)

    # -m unifies every tailed file into one scrolling pane -- a single
    # pseudo-"file" as far as rendering/scrolling/paging are concerned, so
    # the rest of the TUI (draw_screen, key handling) doesn't need to know
    # the difference. n_display is that pane count: 1 when merged, else one
    # real column per file.
    n_display = 1 if merged else len(files)

    # Per-file tag shown at the start of each merged line. If every filename
    # shares a common prefix/suffix (e.g. same base name, differing only by
    # .err/.out), the tag is just the differing part -- otherwise the full
    # basename. Either way it's then truncated in the middle (not off one
    # end, so a distinguishing suffix survives) and padded to a shared width
    # so text starts in a consistent column. The top header bar always shows
    # the full, untruncated names regardless -- merge_header_label, built
    # separately below, is never based on these.
    basenames = [os.path.basename(f) for f in files]
    tag_sources = distinguishing_tags(basenames)
    merge_tags = [truncate_middle(t, MERGE_TAG_MAXLEN) for t in tag_sources]
    merge_tag_width = max((len(t) for t in merge_tags), default=0)
    merge_header_label = ", ".join(basenames)

    def format_merge_prefix(fi):
        tag_text = merge_tags[fi].ljust(merge_tag_width)
        if tag_colors:
            color = _TAG_PALETTE[fi % len(_TAG_PALETTE)]
            tag_text = f"{color}{tag_text}{_COLOR_RESET}"
        return tag_text + MERGE_DIVIDER

    col_widths = compute_col_widths(width, n_display)
    div_fracs = [d / width for d in get_divider_cols(col_widths)]

    # Enter alternate screen, hide cursor, enable mouse (button+motion, SGR encoding)
    sys.stdout.write('\033[?1049h\033[2J\033[H\033[?25l\033[?1002h\033[?1006h')
    sys.stdout.flush()

    old_termios = None
    if sys.stdin.isatty():
        import termios, tty
        old_termios = termios.tcgetattr(sys.stdin.fileno())
        tty.setcbreak(sys.stdin.fileno())

    running = True
    follow_mode = True          # True = live tail; False = frozen at view_tops
    view_tops = [0] * n_display
    dragging_divider = None     # index of divider currently being dragged
    # Text selection: [column, anchor, cursor], anchor/cursor being (raw line
    # index, visible offset) into that column's buffer -- content positions,
    # not screen ones, so the highlight stays on its text through scrolling,
    # divider drags and resizes.
    sel = None
    selecting = False           # left button is down on a selection drag
    resume_follow = False       # go back to live tail once the drag ends
    row_map = []                # from the last draw_screen; see locate()

    def _quit(sig, frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, _quit)
    signal.signal(signal.SIGTERM, _quit)

    needs_redraw = True

    def _resize(sig, frame):
        nonlocal width, height, needs_redraw, n_lines, col_widths
        width, height = get_terminal_size()
        if not n_lines_given:
            n_lines = height
        col_widths = fracs_to_col_widths(div_fracs, width, n_display)
        needs_redraw = True

    signal.signal(signal.SIGWINCH, _resize)

    def locate(col, row, pane=None):
        """Map a 0-indexed screen cell to (column, raw line index, visible
        offset). With pane given, the cell is clamped into that column, so a
        drag that strays outside it keeps extending the selection inside."""
        starts = [0] + [d + 1 for d in get_divider_cols(col_widths)]
        if pane is None:
            pane = max(i for i, s in enumerate(starts) if s <= col)
        if pane >= len(row_map) or not row_map[pane]:
            return None
        rows = row_map[pane]
        cw = col_widths[pane]
        max_len = max(1, cw - 1 if pane < n_display - 1 else cw)
        x = max(0, min(col - starts[pane], max_len - 1))
        hit = rows[max(0, min(row - 1, len(rows) - 1))]
        if hit is None:
            # Below the last line: snap to the end of it.
            filled = [r for r in rows if r is not None]
            return (pane, filled[-1][0], sys.maxsize) if filled else None
        return pane, hit[0], hit[1] + x

    procs, selector = [], selectors.DefaultSelector()
    last_frame = []  # last drawn frame, left visible in the finally block on exit

    try:
        if sys.stdin.isatty():
            selector.register(sys.stdin, selectors.EVENT_READ, data='stdin')

        for i, f in enumerate(files):
            p = subprocess.Popen(
                ['tail', '-Fn', str(n_lines), f],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                universal_newlines=True, bufsize=1,
            )
            os.set_blocking(p.stdout.fileno(), False)
            selector.register(p.stdout, selectors.EVENT_READ, data=i)
            procs.append(p)

        buffers = [[]] if merged else [[] for _ in files]
        display_files = [merge_header_label] if merged else files

        if merged:
            # Each file's initial `tail -n` backlog lands almost immediately;
            # give them a brief, quiescence-bounded window to arrive fully
            # before merging, so we can order whole per-file backlogs by
            # size (longer content first) instead of arbitrary arrival order.
            # Ongoing live output afterward is just interleaved as it comes.
            initial_lines = [[] for _ in files]
            prime_deadline = time.time() + MERGE_PRIME_MAX_S
            quiet_since = time.time()
            while time.time() < prime_deadline:
                got_any = False
                for key, _ in selector.select(timeout=0.05):
                    if key.data == 'stdin':
                        continue
                    fi = key.data
                    try:
                        while True:
                            line = procs[fi].stdout.readline()
                            if not line:
                                break
                            initial_lines[fi].append(colorize_keywords(line.rstrip('\n')))
                            got_any = True
                    except (IOError, OSError):
                        pass
                if got_any:
                    quiet_since = time.time()
                elif time.time() - quiet_since > MERGE_PRIME_QUIET_S:
                    break
            for fi in sorted(range(len(files)), key=lambda idx: len(initial_lines[idx]), reverse=True):
                for text in initial_lines[fi]:
                    buffers[0].append(format_merge_prefix(fi) + text)

        while running:
            if needs_redraw:
                view_tops, at_bottom, last_frame, row_map = draw_screen(
                    display_files, buffers, width, height, follow_mode, view_tops, col_widths,
                    merged=merged,
                    selection=(sel[0], *sorted(sel[1:])) if sel else None,
                )
                needs_redraw = False
                # Reaching the bottom via a manual scroll (j/d/f/...) resumes
                # live-follow instead of leaving the view stuck showing "END"
                # until 'G' is pressed explicitly.
                # (Not mid-selection though: the view stays frozen so the
                # text doesn't move out from under the pointer.)
                if not follow_mode and at_bottom and not selecting:
                    follow_mode = True
                    needs_redraw = True

            for key, _ in selector.select(timeout=0.1):
                if key.data == 'stdin':
                    try:
                        raw = read_key(sys.stdin.fileno())
                        cl = height - 1  # visible content lines

                        mice = parse_mouse(raw)
                        for btn, col, row, pressed in mice:
                            if btn == 0 and pressed:
                                # Left button press: start drag if on a divider
                                div_cols = get_divider_cols(col_widths)
                                dragging_divider = None
                                for d_idx, d_col in enumerate(div_cols):
                                    if col == d_col:
                                        dragging_divider = d_idx
                                        break
                                # Anywhere else in the content area it anchors
                                # a text selection (and drops the old one).
                                sel = None
                                pos = locate(col, row) if dragging_divider is None and row >= 1 else None
                                if pos:
                                    sel = [pos[0], pos[1:], pos[1:]]
                                    selecting = True
                                    resume_follow = follow_mode
                                    follow_mode = False
                                needs_redraw = True
                            elif btn == 32 and dragging_divider is not None:
                                # Left drag: move split, cascading into neighbors if needed
                                div_cols = get_divider_cols(col_widths)
                                new_div_cols = drag_divider(dragging_divider, col, div_cols, width)
                                col_widths = dividers_to_widths(new_div_cols, width, n_display)
                                div_fracs = [d / width for d in new_div_cols]
                                needs_redraw = True
                            elif btn == 32 and selecting and sel:
                                # Left drag: extend the selection
                                pos = locate(col, row, sel[0])
                                if pos and pos[1:] != sel[2]:
                                    sel[2] = pos[1:]
                                    needs_redraw = True
                            elif btn & 0x40:
                                # Wheel event: bit 6 set, direction is the low
                                # two bits (64=up, 65=down) with modifier
                                # flags (shift/meta/ctrl = 4/8/16) possibly
                                # layered on top -- mask those off.
                                base = btn & ~0x1C
                                if base == 64:
                                    follow_mode = False
                                    resume_follow = False
                                    view_tops = [max(0, t - WHEEL_SCROLL_LINES) for t in view_tops]
                                    needs_redraw = True
                                elif base == 65 and not follow_mode:
                                    view_tops = [t + WHEEL_SCROLL_LINES for t in view_tops]
                                    needs_redraw = True
                            elif not pressed:
                                dragging_divider = None
                                if selecting:
                                    # Release: copy what was dragged over. The
                                    # highlight stays up until the next click;
                                    # a click with no drag just clears it.
                                    selecting = False
                                    if sel and sel[1] != sel[2]:
                                        osc52_copy(selection_text(buffers[sel[0]], *sorted(sel[1:])))
                                    else:
                                        sel = None
                                    follow_mode = follow_mode or resume_follow
                                    needs_redraw = True

                        if mice:
                            continue

                        if raw == b'q':
                            running = False

                        elif raw in (b'k', b'\033[A'):  # k / Up: scroll up one line
                            follow_mode = False
                            view_tops = [max(0, t - 1) for t in view_tops]
                            needs_redraw = True

                        elif raw in (b'j', b'\033[B'):  # j / Down: scroll down one line
                            if not follow_mode:
                                view_tops = [t + 1 for t in view_tops]
                                needs_redraw = True

                        elif raw in (b'u', b'\033[5~'):  # u / PgUp: half page up
                            follow_mode = False
                            view_tops = [max(0, t - max(1, cl // 2)) for t in view_tops]
                            needs_redraw = True

                        elif raw in (b'd', b'\033[6~'):  # d / PgDn: half page down
                            if not follow_mode:
                                view_tops = [t + max(1, cl // 2) for t in view_tops]
                                needs_redraw = True

                        elif raw == b'b':  # b: full page up
                            follow_mode = False
                            view_tops = [max(0, t - cl) for t in view_tops]
                            needs_redraw = True

                        elif raw == b'f':  # f: full page down
                            if not follow_mode:
                                view_tops = [t + cl for t in view_tops]
                                needs_redraw = True

                        elif raw == b'G':  # G: go to bottom / resume live tail
                            follow_mode = True
                            needs_redraw = True

                        elif raw == b'\033':  # Esc: clear the selection highlight
                            sel = None
                            needs_redraw = True

                        elif raw == b'g':  # g: go to top of history
                            follow_mode = False
                            view_tops = [0] * n_display
                            needs_redraw = True

                    except (IOError, OSError):
                        pass
                    continue

                fi = key.data
                try:
                    while True:
                        line = procs[fi].stdout.readline()
                        if not line:
                            break
                        text = colorize_keywords(line.rstrip('\n'))
                        if merged:
                            text = format_merge_prefix(fi) + text
                            target = 0
                        else:
                            target = fi
                        buffers[target].append(text)
                        if len(buffers[target]) > MAX_BUFFER:
                            drop = len(buffers[target]) - MAX_BUFFER
                            buffers[target] = buffers[target][-MAX_BUFFER:]
                            if not follow_mode and target < len(view_tops):
                                view_tops[target] = max(0, view_tops[target] - drop)
                            if sel and sel[0] == target:
                                sel[1:] = [(l - drop, o) for l, o in sel[1:]]
                                if min(sel[1][0], sel[2][0]) < 0:
                                    sel = None
                        needs_redraw = True
                except (IOError, OSError):
                    pass

    finally:
        if old_termios:
            import termios
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_termios)
        # Disable mouse, leave the alternate screen (back to whatever's on
        # the primary buffer), then replay the last drawn frame onto it --
        # otherwise leaving alt-screen would just silently discard it and
        # restore whatever was there before tl started, instead of leaving
        # the final view visible in the shell's own scrollback.
        sys.stdout.write('\033[?1002l\033[?1006l\033[?1049l')
        if last_frame:
            sys.stdout.write('\n'.join(last_frame) + '\n')
        sys.stdout.write('\033[?25h')
        sys.stdout.flush()
        for p in procs:
            p.terminate()
            p.wait()


if __name__ == '__main__':
    main()
