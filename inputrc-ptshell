# Readline config for pt_shell running under rlwrap.
#
# Point rlwrap at this file instead of ~/.inputrc:
#     INPUTRC=~/dotfiles/inputrc-ptshell rlwrap pt_shell ...

set editing-mode emacs

# Standard completion and prompt settings
set show-all-if-ambiguous on
set menu-complete-display-prefix on
set completion-ignore-case on

"\C-w": unix-word-rubout
"\177": backward-delete-char
"\C-h": backward-delete-char
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\e[5C": forward-word
"\e[5D": backward-word
"\eOc": forward-word
"\eOd": backward-word
"\e\e[C": forward-word
"\e\e[D": backward-word
