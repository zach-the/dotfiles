# Readline config for pt_shell running under rlwrap.
#
# Cursor shape ONLY -- no [I]/[N] prompt indicators, because pt_shell
# garbles prompt-line rewrites. The \1...\2 wrappers mark the escapes
# zero-width, so the visible prompt never changes length and readline's
# mode-switch redisplay stays a no-op on screen.
#
# Point rlwrap at this file instead of ~/.inputrc:
#     INPUTRC=~/dotfiles/inputrc-ptshell rlwrap pt_shell ...

set editing-mode vi
set show-mode-in-prompt on

set vi-ins-mode-string "\1\e[6 q\2"
set vi-cmd-mode-string "\1\e[2 q\2"

# Keep the bits of your normal setup that don't touch the prompt.
set show-all-if-ambiguous on
set menu-complete-display-prefix on
set completion-ignore-case on

set keymap vi-insert
TAB: menu-complete
"\e[Z": menu-complete-backward
"\C-w": unix-word-rubout

set keymap vi-command
"\177": backward-delete-char
"\C-h": backward-delete-char

