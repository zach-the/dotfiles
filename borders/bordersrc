#!/bin/bash

# Matches tmux's active pane border color (@pink, from
# palettes/very-dark.toml -> tmux/tmux-colors.conf: pane-active-border-style)
# so the macOS focused-window border and tmux's dividing lines agree.
#   active:   @pink   #ff007f
#   inactive: @grey   #787c99
#   rounding: 10 (decoration.rounding) -> style=round

options=(
  style=round
  width=5.0
  hidpi=on
  active_color=0xffff007f
  inactive_color=0xaa787c99
)

borders "${options[@]}"
